# Copy to .env and adjust. All values here are safe local defaults.

# Storage
DATABASE_URL=sqlite:///./transcriptions.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
# Delete the audio file once its transcription is saved (failed jobs keep theirs).
DELETE_AUDIO_AFTER_SUCCESS=true

# Celery / Redis
REDIS_URL=redis://localhost:6379/0
# Worker processes per `celery worker`. Each one loads its own Whisper model.
CELERY_WORKER_CONCURRENCY=2

# Retries: delay = base * 2^retry (plus jitter), capped at max
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_BASE_SECONDS=5
TASK_RETRY_BACKOFF_MAX_SECONDS=300
# A job stuck in "processing" this long is assumed abandoned (worker crashed).
STALE_JOB_SECONDS=3600

# Whisper: tiny | base | small | medium | large (bigger = slower, more accurate)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# Leave unset to auto-detect, or set e.g. WHISPER_LANGUAGE=en
# WHISPER_LANGUAGE=

# Dev only: fail the first N attempts of every job to demo retries.
SIMULATE_TRANSIENT_FAILURES=0

LOG_LEVEL=INFO
